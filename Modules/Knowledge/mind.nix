{ inputs, ... }: {
  flake.nixosModules.Tn-mind = { pkgs, lib, config, ... }:
  let
    pal = import ../Core/_palette.nix;   # Technonomicon's colours
    r = pal.roles;
    b = n: "#${pal.base16.${n}}";
    # "#69ABEF" -> "105,171,239", for Minimal's --color-*-rgb
    rgb = hex: lib.concatMapStringsSep ","
      (i: toString (lib.fromHexString (builtins.substring i 2 hex))) [ 1 3 5 ];
    colors = { red = b "base08"; orange = b "base09"; yellow = b "base0A";
               green = b "base0B"; cyan = b "base0C"; blue = b "base0D";
               purple = b "base0E"; pink = b "base0E"; };

    # Obsidian in the palette: a CSS snippet over the Minimal theme. Minimal
    # draws everything from its scheme variables (bg1-3, ui1-3, tx1-4, hl1-2,
    # the accent and --color-*), so overriding those recolours the whole app;
    # the triple class beats Minimal's ".theme-dark.<scheme>" rules. Code
    # follows the rest of the system: comments yellow, strings green,
    # constants red, definitions blue, punctuation grey, the rest plain; and
    # the row being chosen (quick switcher, command palette, suggestions,
    # menus) is solid blue with dark text.
    # Accent #69ABEF as Obsidian's HSL: 210 81% 67%.
    snippet = pkgs.writeText "technonomicon.css" ''
      /* Generated by Technonomicon (Tn-mind, from _palette.nix); edits are overwritten. */
      .theme-dark.theme-dark.theme-dark {
        --accent-h: 210; --accent-s: 81%; --accent-l: 67%;
        --bg1: ${r.bg};
        --bg2: ${r.surface};
        --bg3: ${r.sel};
        --ui1: ${r.border};
        --ui2: ${r.whitespace};
        --ui3: ${r.dim};
        --tx1: ${r.plain};
        --tx2: ${r.second};
        --tx3: ${r.dim};
        --tx4: ${r.plain};
        --hl1: ${r.sel};
        --hl2: rgba(${rgb r.search},0.30);
        --text-selection: ${r.sel};
        --active-line-bg: ${r.linehl};
        --background-modifier-border: ${r.border};
        --text-error: ${r.error};
        --text-warning: ${r.warn};
        --text-success: ${r.add};
      ${lib.concatStrings (lib.mapAttrsToList (n: c:
          "  --color-${n}: ${c}; --color-${n}-rgb: ${rgb c};\n") colors)}
        --code-background: ${r.surface};
        --code-normal: ${r.plain};
        --code-comment: ${r.comment};
        --code-string: ${r.string};
        --code-value: ${r.const};
        --code-function: ${r.plain};
        --code-keyword: ${r.plain};
        --code-property: ${r.plain};
        --code-tag: ${r.plain};
        --code-important: ${r.error};
        --code-operator: ${r.punct};
        --code-punctuation: ${r.punct};
      }

      /* definitions: CodeMirror in the editor, Prism in reading view */
      .theme-dark .cm-def, .theme-dark .cm-variable-2.cm-def,
      .theme-dark .token.function-definition, .theme-dark .token.class-name {
        color: ${r.def};
      }
      /* no bold or italic in code */
      .theme-dark .cm-hmd-codeblock, .theme-dark .cm-inline-code,
      .theme-dark pre code, .theme-dark pre code .token {
        font-weight: normal; font-style: normal;
      }

      /* the row being chosen */
      .theme-dark .suggestion-item.is-selected,
      .theme-dark .menu-item.selected:not(.is-disabled):not(.is-label),
      .theme-dark .menu-item:hover:not(.is-disabled):not(.is-label) {
        background-color: ${r.accent};
        color: ${r.bg};
      }
      .theme-dark .suggestion-item.is-selected *,
      .theme-dark .menu-item.selected:not(.is-disabled):not(.is-label) *,
      .theme-dark .menu-item:hover:not(.is-disabled):not(.is-label) * {
        color: ${r.bg};
      }
    '';
  in {
    environment.systemPackages = with pkgs; [
      obsidian
      pomodoro-gtk
    ];

    # Habits, tasks and notes; works offline and syncs through Akmon
    # (Tn-openhabittracker). Flathub only; the flatpak setup itself is in
    # Tn-communication.
    services.flatpak.packages = [
      { appId = "net.openhabittracker.OpenHabitTracker"; origin = "flathub"; }
    ];

    xdg.mime.defaultApplications = {
      "x-scheme-handler/obsidian" = "md.obsidian.Obsidian.desktop";
    };

    home-manager.users.xin = { lib, ... }: {
      # Obsidian's desktop entry comes from the nixpkgs package and carries no
      # Keywords, so the launcher can't find it by "notes". This user-level entry has the
      # same desktop id and shadows the system one (XDG_DATA_HOME wins) — if
      # nixpkgs renames its file again, rename this one to match or both show.
      home.file.".local/share/applications/md.obsidian.Obsidian.desktop".text = ''
        [Desktop Entry]
        Categories=Office
        Comment=Knowledge base
        Exec=obsidian %u
        Icon=obsidian
        Keywords=notes;note;markdown;vault;knowledge;zettelkasten;
        MimeType=x-scheme-handler/obsidian
        Name=Obsidian
        StartupWMClass=md.obsidian.Obsidian
        Terminal=false
        Type=Application
      '';

      # The snippet is copied in, not symlinked: the vault syncs to the phone
      # and Akmon, where a /nix/store link would dangle. .obsidian/snippets
      # isn't part of the note index, and Obsidian reloads a changed snippet
      # by itself. It is switched on in Appearance -> CSS snippets ("technonomicon"),
      # with the accent colour set to the palette's blue.
      home.activation.obsidianSnippet = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        dir="$HOME/Grimoire/.obsidian/snippets"
        if [ -d "$HOME/Grimoire/.obsidian" ] && ! ${pkgs.diffutils}/bin/cmp -s ${snippet} "$dir/technonomicon.css"; then
          run install -Dm644 ${snippet} "$dir/technonomicon.css"
        fi
      '';
    };
  };
}
