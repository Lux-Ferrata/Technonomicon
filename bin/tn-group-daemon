#!/usr/bin/env bash
# Listen for new tiling windows and auto-group them on the workspace.
# force_split=1 ensures new windows always land RIGHT of the focused window,
# so the existing group is always LEFT — moveintogroup l reliably finds it.
# If moveintogroup l fails (no group exists yet), togglegroup creates one.

[ -z "$HYPRLAND_INSTANCE_SIGNATURE" ] && exit 1

SOCK="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

socat -u "UNIX-CONNECT:$SOCK" - | while IFS= read -r line; do
  [[ "$line" != openwindow\>\>* ]] && continue

  data="${line#openwindow>>}"
  addr="0x${data%%,*}"

  sleep 0.15

  # Skip floating windows
  is_float=$(hyprctl clients -j | jq -r --arg a "$addr" \
    '.[] | select(.address == $a) | .floating // false')
  [ "$is_float" = "true" ] && continue

  # Skip if window no longer exists (closed quickly)
  exists=$(hyprctl clients -j | jq --arg a "$addr" \
    '[.[] | select(.address == $a)] | length > 0')
  [ "$exists" != "true" ] && continue

  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1

  # Try to join existing group to the left.
  # If that fails (exit non-zero = no group there), create a new group.
  if ! hyprctl dispatch moveintogroup l >/dev/null 2>&1; then
    hyprctl dispatch togglegroup >/dev/null 2>&1
  fi
done
